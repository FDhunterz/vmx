{
  "$schemaNote": "Token dasar UI modern glass VMX. Update ini dulu sebelum redesign komponen.",
  "color": {
    "bg": {
      "base": "#07090F",
      "elevated": "#0E1220",
      "surface": "#131A2A",
      "muted": "#1A2336",
      "gradientA": "#7C8BFF",
      "gradientB": "#22D3EE",
      "gradientC": "#A78BFA"
    },
    "text": {
      "primary": "#F6F8FF",
      "secondary": "#C2CBE1",
      "muted": "#91A0BD",
      "inverse": "#09090B"
